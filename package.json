{
	"name": "airchecker",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "concurrently -k -n checker,sim,checker-web,sim-web -c blue,magenta,cyan,yellow \"npm run backend -w checker\" \"npm run server -w simulator\" \"npm run frontend:dev -w checker\" \"npm run frontend:dev -w simulator\"",
		"test": "npm test --workspaces"
	},
	"devDependencies": {
		"@eslint-react/eslint-plugin": "^5.21.1",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^22.20.4",
		"concurrently": "^10.0.5",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-perfectionist": "^5.12.1",
		"eslint-plugin-prettier": "^5.5.6",
		"prettier": "^3.9.9",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.1",
		"vitest": "^2.1.9"
	}
}
