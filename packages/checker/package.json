	"private": true,
	"type": "module",
	"scripts": {
		"test": "vitest run",
		"chrome": "'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome' --remote-debugging-port=9222 --user-data-dir=$HOME/.nn-airchecker-chrome --window-size=960,540 --window-position=0,0 https://stream.directv.com/player",
